
@model IEnumerable<SQLDBApp.Models.DataItems.DataItemProduct>
@{ViewData["Title"] = "Inventory";Layout = "~/Views/Shared/_Layout.cshtml";}
<main id="main" class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Inventory</h1>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="my" class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="w-25">@Html.DisplayNameFor(model => model.Title)</th>
                            <th class="d-none d-md-table-cell">@Html.DisplayNameFor(model => model.ImgMain)</th>
                            <th>@Html.DisplayNameFor(model => model.Item)</th>
                            <th class="d-none d-lg-table-cell">@Html.DisplayNameFor(model => model.Model)</th>
                            <th class="text-end">Buy</th>
                            <th class="text-end d-none d-sm-table-cell">Current</th>
                            <th class="text-end d-none d-lg-table-cell">Adv Buy</th>
                            <th class="text-end d-none d-lg-table-cell">Adv Curr</th>
                            <th class="text-center">Backordered</th>
                            <th class="d-none d-xl-table-cell">@Html.DisplayNameFor(model => model.DateLastAvail)</th>
                            <th class="d-none d-sm-table-cell">@Html.DisplayNameFor(model => model.UnitOfMeas)</th>
                            <th class="text-center">Collected</th>
                            <th class="text-center">Active</th>
                            <th class="d-none d-lg-table-cell">@Html.DisplayNameFor(model => model.DateLastUpdated)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-start gap-3">
                                        <img src="@item.Url" alt="" class="rounded" style="width:80px; height:80px; object-fit:cover;" />
                                        <div>
                                            <div class="fw-semibold">@Html.DisplayFor(modelItem => item.Title)</div>
                                            <div class="text-muted small">@Html.DisplayFor(modelItem => item.Item)</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell align-middle">
                                    <span class="text-muted small">Image</span>
                                </td>
                                <td class="align-middle d-none d-md-table-cell">@Html.DisplayFor(modelItem => item.Item)</td>
                                <td class="align-middle d-none d-lg-table-cell">@Html.DisplayFor(modelItem => item.Model)</td>
                                <td class="align-middle text-end">
                                    <span class="text-muted">@String.Format("{0:C}", item.PriceBuyDef)</span>
                                </td>
                                <td class="align-middle text-end d-none d-sm-table-cell">
                                    <span class="fw-bold text-success">@String.Format("{0:C}", item.PriceBuyCurrent)</span>
                                </td>
                                <td class="align-middle text-end d-none d-lg-table-cell">@String.Format("{0:C}", item.PriceBuyDefAdv)</td>
                                <td class="align-middle text-end d-none d-lg-table-cell">@String.Format("{0:C}", item.PriceBuyCurrentAdv)</td>
                                <td class="align-middle text-center">
                                    @if (item.IsAllBackOrdered)
                                    {
                                        <span class="badge bg-warning text-dark">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td class="align-middle d-none d-xl-table-cell">@Html.DisplayFor(modelItem => item.DateLastAvail)</td>
                                <td class="align-middle d-none d-sm-table-cell">@Html.DisplayFor(modelItem => item.UnitOfMeas)</td>
                                <td class="align-middle text-center">
                                    @if (item.IsCollectedFull)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">Inactive</span>
                                    }
                                </td>
                                <td class="align-middle d-none d-lg-table-cell">@Html.DisplayFor(modelItem => item.DateLastUpdated)</td>
                                <td class="align-middle text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted small">Updated @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm")</div>
    </div>
</main>
@section Scripts{@await Html.PartialAsync("_ValidationScriptsPartial")}
